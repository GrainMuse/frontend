# Copy to supabase/functions/.env.local for local development only.
# These are Cloudflare's official always-pass test credentials. Never deploy
# them to staging or production.

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Direct dummy-token Siteverify responses use example.com; browser-generated
# test tokens use the local page hostname.
TURNSTILE_EXPECTED_HOSTNAMES=localhost,127.0.0.1,example.com
# Local-only deterministic value. Hosted environments require unique random salts.
RATE_LIMIT_SALT=grainmuse-local-only-rate-limit-salt-v1
# EmailJS is the only supported email provider.
CONTACT_EMAIL_PROVIDER=emailjs
CONTACT_TO_EMAIL=trade@grainmuse.net

# EmailJS server-side notification settings. Keep these out of VITE_ variables.
EMAILJS_SERVICE_ID=service_xxxxxxxx
# Existing main contact-template ID.
EMAILJS_TEMPLATE_ID=template_xxxxxxxx
# Existing auto-reply template ID, also used directly for academy notifications.
EMAILJS_AUTOREPLY_TEMPLATE_ID=template_autoreply_xxxxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
# Optional. Set this when private-key authorization is enabled in EmailJS.
EMAILJS_PRIVATE_KEY=

# The existing auto-reply template handles contact confirmations and academy
# email. Copy emailjs-template.html into it and follow EMAILJS_TEMPLATE.md.
ACADEMY_ADMIN_EMAIL=trade@grainmuse.net
# Use a random processor secret of at least 32 characters.
ACADEMY_NOTIFICATION_PROCESSOR_SECRET=replace_with_a_random_32_character_secret
