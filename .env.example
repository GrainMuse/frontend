# ─────────────────────────────────────────────────────────────
# Grain Muse — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# Only browser-safe values may use the VITE_ prefix. Backend secrets belong in
# the backend or Edge Function secret store.
#
# Supabase - browser-safe project settings
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# NEVER expose a Supabase secret or legacy service_role key with a VITE_ prefix.

# Server-only values used by /api/admin/invitations in the deployed frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
ADMIN_INVITE_REDIRECT_URL=https://www.example.com/admin/accept-invite

# Contact backend rollout switch. Keep "emailjs" in production until the
# Supabase function and Turnstile pass staging tests.
VITE_CONTACT_BACKEND=emailjs
VITE_TURNSTILE_SITE_KEY=replace_with_browser_safe_turnstile_site_key
#
# Vite exposes only VITE_-prefixed values to browser code.
# ─────────────────────────────────────────────────────────────

# EmailJS — https://www.emailjs.com
# Get these from your EmailJS dashboard after setup.

# Dashboard → Account → General → Public Key
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# Dashboard → Email Services → [your Gmail service] → Service ID
VITE_EMAILJS_SERVICE_ID=service_xxxxxxxx

# Dashboard → Email Templates → [grainmuse_contact] → Template ID
# This template sends the notification to trade@grainmuse.net
VITE_EMAILJS_TEMPLATE_CONTACT=template_xxxxxxxx

# Dashboard → Email Templates → [grainmuse_autoreply] → Template ID
# This template sends the auto-reply to the visitor
# Leave blank to disable auto-replies
VITE_EMAILJS_TEMPLATE_AUTOREPLY=template_xxxxxxxx

GRAINMUSE_EMAIL= #official grainmuse email
